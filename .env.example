# Apify API Token — get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API Key — get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets ID — extract from sheet URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID_IS_HERE/edit
GOOGLE_SHEETS_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# Google Service Account JSON — TWO OPTIONS:
#
# OPTION A (Recommended for Render/cloud): Base64-encode your JSON key file:
#   Mac/Linux: base64 -i service-account.json | tr -d '\n'
#   Windows:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("sa.json"))
# Paste the resulting base64 string here:
GOOGLE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLn0=

# OPTION B (Local dev only): Paste raw JSON on one line (breaks on Render):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Port for the unified HTTP server (Render sets this automatically — do not override)
PORT=3000

# For local webhook testing: set to your ngrok URL so Apify can reach your machine.
# Leave unset on Render (RENDER_EXTERNAL_URL is used automatically instead).
# WEBHOOK_URL=https://xxxx.ngrok.io

# Optional: Override cron schedule (default: 06:00 AM UTC)
# "30 0 * * *" = 12:30 AM UTC = 6:00 AM IST
CRON_SCHEDULE=30 0 * * *

# Optional: Minimum lead score to keep (default: 6)
MIN_LEAD_SCORE=6

# Optional: Target location for search queries (default: India)
TARGET_LOCATION=India
